# Dim direnv status messages
export DIRENV_LOG_FORMAT=$'\033[2mdirenv: %s\033[0m'

# source .venv/bin/activate

export ZMK_BUILD_DIR="$(pwd)/build"
export ZMK_SRC_DIR="$(pwd)/zmk/app"

# # Also rebuild if other local flake inputs change
# watch_file nix/*
#
# # Use flake
# use flake
export ZEPHYR_SDK_INSTALL_DIR=/home/btilford/zephyr-sdk-0.16.5
export PATH=/home/btilford/zephyr-sdk-0.16.5/arm-zephyr-eabi/bin:$PATH

# Zephyr 3.5 (ZMK v0.3.0) breaks under CMake >= 4; use the pinned CMake from
# the repo venv (python -m venv .venv && pip install 'cmake>=3.20,<4').
PATH_add .venv/bin

# Pin Zephyr to this checkout — the CMake user package registry
# (~/.cmake/packages/Zephyr) otherwise resolves to whichever tree registered
# last and can mix worktrees.
export ZEPHYR_BASE="$(pwd)/zephyr"


